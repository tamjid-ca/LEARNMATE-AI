# ==============================================================================
# LearnMate AI — Environment Configuration Template
# Never commit real secrets to version control. Copy to .env.local for local dev.
# ==============================================================================

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (MongoDB Atlas or local replica set)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/learnmate_ai?retryWrites=true&w=majority

# Authentication & Session Security
AUTH_SECRET=replace-with-at-least-32-bytes-of-cryptographic-random-hex

# OpenRouter AI Gateway (Server-Side Only — NEVER prefix with NEXT_PUBLIC_)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openrouter/free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=LearnMate AI

# Optional Per-Task OpenRouter Model Overrides (fallback to OPENROUTER_DEFAULT_MODEL)
AI_MODEL_TUTOR=openrouter/free
AI_MODEL_EXPLANATION=openrouter/free
AI_MODEL_SUMMARIZATION=openrouter/free
AI_MODEL_QUIZ_GENERATION=openrouter/free
AI_MODEL_QUIZ_EVALUATION=openrouter/free
AI_MODEL_FLASHCARDS=openrouter/free
AI_MODEL_PLANNER=openrouter/free
AI_MODEL_DOCUMENT_QA=openrouter/free
AI_MODEL_RECOMMENDATIONS=openrouter/free

# Optional Semantic Embeddings (RAG falls back to keyword retrieval when unset)
AI_EMBEDDING_MODEL=

# Object Storage (Vercel Blob or compatible S3 adapter)
BLOB_READ_WRITE_TOKEN=

# Background Job / Scheduled Processing Verification
CRON_SECRET=replace-with-random-cron-secret

# Observability
LOG_LEVEL=info
